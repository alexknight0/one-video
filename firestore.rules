rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One Video is a single-user app: only Alex may read or write anything.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == "octopus0246@gmail.com";
    }

    // The saved video lives under video/current (+ its chunks subcollection).
    match /video/{docId} {
      allow read, write: if isOwner();
      match /chunks/{chunkId} {
        allow read, write: if isOwner();
      }
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

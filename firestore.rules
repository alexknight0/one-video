rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Alex (the admin) owns the video: only he can change it. Anyone whose email (lower-case)
    // is in config/access.emails may watch it; only Alex can read or edit that list (the
    // Access page on /home/).
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isOwner() {
      return signedIn() && request.auth.token.email.lower() == "octopus0246@gmail.com";
    }
    function canWatch() {
      return isOwner() || (signedIn()
        && exists(/databases/$(database)/documents/config/access)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/access).data.emails);
    }

    match /config/access {
      allow read, write: if isOwner();
    }

    // The saved video lives under video/current (+ its chunks subcollection).
    match /video/{docId} {
      allow read: if canWatch();
      allow write: if isOwner();
      match /chunks/{chunkId} {
        allow read: if canWatch();
        allow write: if isOwner();
      }
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
